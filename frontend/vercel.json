{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact_us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/tour-packages",
      "destination": "/tours",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/booking/desert-safari",
      "destination": "/desert-safari-dubai-tours",
      "permanent": true
    },
    {
      "source": "/booking/abu-dhabi-city-tour",
      "destination": "/abu-dhabi-city-tours",
      "permanent": true
    },
    {
      "source": "/booking/dubai-city-tour",
      "destination": "/tours/dubai-city-tour",
      "permanent": true
    },
    {
      "source": "/booking/global-village-dubai",
      "destination": "/global-village-dubai",
      "permanent": true
    },
    {
      "source": "/tours/abu-dhabi-city-tour",
      "destination": "/abu-dhabi-city-tours",
      "permanent": true
    },
    {
      "source": "/tours/global-village-dubai",
      "destination": "/global-village-dubai",
      "permanent": true
    },
    {
      "source": "/tours/desert-safari-dubai",
      "destination": "/desert-safari-dubai-tours",
      "permanent": true
    },
    {
      "source": "/dubai-airport-transfer",
      "destination": "/transfers",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/faqs",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/proxy.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/proxy?path=api/health"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/proxy?path=api/auth/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/proxy?path=api/admin/:path*"
    },
    {
      "source": "/api/public/:path*",
      "destination": "/api/proxy?path=api/public/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "/api/proxy?path=media/:path*"
    },
    {
      "source": "/blog",
      "destination": "/api/proxy?path=blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/proxy?path=blog/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/proxy?path=sitemap.xml"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    }
  ]
}
