{
  "name": "zuhd-tours-backend",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:integration": "node test/integration.mjs",
    "reset-password": "node scripts/reset-password.mjs",
    "setup": "node scripts/setup-env.mjs",
    "install:frontend": "npm --prefix ../frontend ci",
    "dev:all": "node scripts/dev.mjs",
    "build": "npm --prefix ../frontend run build",
    "check:seo": "npm --prefix ../frontend run check:seo"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.19.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.3",
    "marked": "^16.4.0",
    "sanitize-html": "^2.17.0",
    "dotenv": "^17.2.3",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.0"
  }
}
