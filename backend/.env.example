# Local development. Set production on your hosted backend.
NODE_ENV=development
# Paste your MongoDB Atlas connection string here.
MONGODB_URI=mongodb://127.0.0.1:27017/zuhd_tours
PUBLIC_SITE_URL=https://www.zuhdtours.com
# Generated by npm run setup. Used only at /admin/setup; blank it after signup.
SETUP_TOKEN=
# Optional public widget ID from Elfsight > Google Reviews > Install.
ELFSIGHT_APP_ID=
